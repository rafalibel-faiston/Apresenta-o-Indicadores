# ID da planilha do Google Sheets que alimenta a apresentação (veja PLANILHA.md).
# Copie o trecho entre /d/ e /edit na URL da planilha:
# https://docs.google.com/spreadsheets/d/ESTE_TRECHO_AQUI/edit
VITE_GOOGLE_SHEET_ID=

# Postgres onde fica a planilha importada (veja IMPORTAR_PLANILHA.md).
# No Railway: ${{Postgres.DATABASE_URL}}. Vazio = arquivos locais em data/ (só dev).
DATABASE_URL=

# Opcional: senha exigida para importar/restaurar a planilha. Vazio = qualquer um pode.
IMPORT_TOKEN=
