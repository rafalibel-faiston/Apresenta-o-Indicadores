import React, { useState } from 'react';
import { motion } from 'motion/react';
import { TrendingUp, FileText, Package, DollarSign, ArrowRightLeft, Percent, HelpCircle } from 'lucide-react';
import { formatCompact, formatCurrency } from './MiniCharts';

interface EntradaSaidaChartProps {
  entrada: {
    nfs: number;
    equipments: number;
    value: number;
  };
  saida: {
    nfs: number;
    equipments: number;
    value: number;
  };
}

type MetricType = 'value' | 'equipments' | 'nfs';

export default function EntradaSaidaChart({ entrada, saida }: EntradaSaidaChartProps) {
  const [activeMetric, setActiveMetric] = useState<MetricType>('value');

  const metrics = [
    {
      id: 'value' as MetricType,
      label: 'Financeiro',
      sublabel: 'Valor Total',
      icon: DollarSign,
      entradaVal: entrada.value,
      saidaVal: saida.value,
      formatter: (v: number) => formatCompact(v),
      fullFormatter: (v: number) => formatCurrency(v),
      color: 'text-indigo-500',
    },
    {
      id: 'equipments' as MetricType,
      label: 'Equipamentos',
      sublabel: 'Volume de Peças',
      icon: Package,
      entradaVal: entrada.equipments,
      saidaVal: saida.equipments,
      formatter: (v: number) => `${v.toLocaleString('pt-BR')} un`,
      fullFormatter: (v: number) => `${v.toLocaleString('pt-BR')} unidades físicas`,
      color: 'text-cyan-500',
    },
    {
      id: 'nfs' as MetricType,
      label: 'Documentos',
      sublabel: 'Notas Fiscais',
      icon: FileText,
      entradaVal: entrada.nfs,
      saidaVal: saida.nfs,
      formatter: (v: number) => `${v} NF-e`,
      fullFormatter: (v: number) => `${v} Notas Fiscais emitidas`,
      color: 'text-amber-500',
    }
  ];

  const currentMetric = metrics.find(m => m.id === activeMetric)!;
  const total = currentMetric.entradaVal + currentMetric.saidaVal;
  const entradaPct = total > 0 ? (currentMetric.entradaVal / total) * 100 : 0;
  const saidaPct = total > 0 ? (currentMetric.saidaVal / total) * 100 : 0;
  const factor = currentMetric.entradaVal > 0 ? (currentMetric.saidaVal / currentMetric.entradaVal).toFixed(1) : '—';

  return (
    <div className="bg-slate-50/70 border border-slate-200/80 rounded-3xl p-5 shadow-sm flex flex-col gap-5 h-full" id="entrada-saida-comparativo-card">
      {/* Header */}
      <div className="flex items-center justify-between border-b border-slate-200/60 pb-3">
        <div className="flex items-center gap-2.5">
          <div className="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-600 flex items-center justify-center">
            <ArrowRightLeft size={16} className="animate-pulse" />
          </div>
          <div>
            <h3 className="text-xs font-black text-slate-800 uppercase tracking-wider">Métricas Comparativas</h3>
            <span className="text-[9px] text-slate-400 font-bold block uppercase tracking-tight">Equilíbrio & Proporção de Fluxo</span>
          </div>
        </div>
      </div>

      {/* Tabs */}
      <div className="grid grid-cols-3 gap-1.5 bg-slate-200/50 p-1 rounded-xl">
        {metrics.map((metric) => {
          const Icon = metric.icon;
          const isActive = activeMetric === metric.id;
          return (
            <button
              key={metric.id}
              onClick={() => setActiveMetric(metric.id)}
              className={`flex flex-col items-center gap-1 py-2 px-1.5 rounded-lg transition-all duration-300 relative cursor-pointer select-none ${
                isActive 
                  ? 'bg-white shadow-sm text-slate-900 border border-slate-200/30' 
                  : 'text-slate-550 hover:bg-white/40 hover:text-slate-800'
              }`}
            >
              <Icon size={13} className={isActive ? metric.color : 'text-slate-400'} />
              <span className="text-[10px] font-black tracking-tight">{metric.label}</span>
            </button>
          );
        })}
      </div>

      {/* Visualization Canvas */}
      <div className="flex-1 flex flex-col justify-center gap-6 py-2">
        {/* Dynamic Horizontal Comparative Bar */}
        <div className="flex flex-col gap-2">

          <div className="w-full h-8 rounded-2xl overflow-hidden flex border border-slate-200 bg-slate-100 shadow-inner p-1">
            {/* Entrada Segment */}
            <motion.div
              layout
              initial={{ width: 0 }}
              animate={{ width: `${Math.max(entradaPct, 8)}%` }}
              transition={{ type: 'spring', stiffness: 80, damping: 15 }}
              className="bg-indigo-500 h-full rounded-l-xl flex items-center justify-center text-[10px] font-bold text-white shadow-sm min-w-8 relative overflow-hidden"
            >
              <span className="z-10">{entradaPct.toFixed(0)}%</span>
              <div className="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent pointer-events-none" />
            </motion.div>

            {/* Gap divider line if both segments have value */}
            {entradaPct > 0 && saidaPct > 0 && <div className="w-0.5 bg-white h-full z-10" />}

            {/* Saída Segment */}
            <motion.div
              layout
              initial={{ width: 0 }}
              animate={{ width: `${Math.max(saidaPct, 8)}%` }}
              transition={{ type: 'spring', stiffness: 80, damping: 15 }}
              className="bg-pink-500 h-full rounded-r-xl flex items-center justify-center text-[10px] font-bold text-white shadow-sm min-w-8 relative overflow-hidden"
            >
              <span className="z-10">{saidaPct.toFixed(0)}%</span>
              <div className="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent pointer-events-none" />
            </motion.div>
          </div>
        </div>

        {/* Vertical volume bars with numbers */}
        <div className="grid grid-cols-2 gap-4">
          {/* ENTRADA VALUE CARD */}
          <div className="border border-indigo-150 bg-indigo-50/40 p-3.5 rounded-2xl flex flex-col gap-1 relative overflow-hidden">
            <div className="absolute top-1 right-2 font-black text-indigo-200/50 text-xl font-mono">IN</div>
            <span className="text-[9px] font-bold text-indigo-550 uppercase">Entrada física</span>
            <span className="text-sm font-black text-indigo-950 font-mono tracking-tight mt-0.5">
              {currentMetric.formatter(currentMetric.entradaVal)}
            </span>
            <span className="text-[9px] text-indigo-500/80 font-extrabold mt-1">
              {currentMetric.fullFormatter(currentMetric.entradaVal)}
            </span>
          </div>

          {/* SAÍDA VALUE CARD */}
          <div className="border border-pink-150 bg-pink-50/40 p-3.5 rounded-2xl flex flex-col gap-1 relative overflow-hidden">
            <div className="absolute top-1 right-2 font-black text-pink-200/50 text-xl font-mono">OUT</div>
            <span className="text-[9px] font-bold text-pink-550 uppercase">Saída física</span>
            <span className="text-sm font-black text-pink-950 font-mono tracking-tight mt-0.5">
              {currentMetric.formatter(currentMetric.saidaVal)}
            </span>
            <span className="text-[9px] text-pink-500/80 font-extrabold mt-1">
              {currentMetric.fullFormatter(currentMetric.saidaVal)}
            </span>
          </div>
        </div>
      </div>

      {/* Analytics Insight Footer */}
      <div className="bg-white border border-slate-200/60 p-3 rounded-2xl flex items-start gap-2.5 shadow-xs">
        <div className="p-1 rounded-lg bg-indigo-50 text-indigo-500 flex-shrink-0 mt-0.5">
          <TrendingUp size={12} strokeWidth={2.5} />
        </div>
        <div>
          <span className="text-[10px] font-black text-slate-800 uppercase tracking-wide block">Relação Operacional</span>
          <p className="text-[10px] font-bold text-slate-500 leading-normal mt-0.5">
            A saída física representa <strong className="text-pink-600 font-extrabold">{factor}x</strong> o fluxo de entrada para a categoria <strong className="text-slate-800 font-black">{currentMetric.label}</strong>.
          </p>
        </div>
      </div>
    </div>
  );
}
